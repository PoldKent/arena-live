{
  "name": "arena-live",
  "private": true,
  "version": "0.40.3",
  "description": "Local TikTok LIVE chat bridge for the Arena Live prototype",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "node tools/build-mobile.mjs",
    "start": "node bridge/server.mjs",
    "predev": "node tools/build-mobile.mjs",
    "dev": "node bridge/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/operator-browser.mjs && node test/integrity-browser.mjs && node test/training-browser.mjs",
    "test:performance": "node test/performance-browser.mjs",
    "test:gpu": "node test/performance-browser.mjs --gpu",
    "test:mobile": "node test/mobile-browser.mjs",
    "verify:release": "npm test && npm run build:mobile && npm run test:browser && npm run test:mobile && npm run test:performance",
    "build:styles": "node tools/build-styles.mjs",
    "build:mobile": "node tools/build-mobile.mjs",
    "clean:branches": "node tools/clean-merged-branches.mjs",
    "analyze:balance": "node test/balance-simulation.mjs"
  },
  "dependencies": {
    "tiktok-live-connector": "2.5.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "tailwindcss": "3.4.17"
  }
}
